  converationLines:
  - speakerName: Antonio
    dialogueLine: "Encantado, yo soy Antonio, he venido de la consejer\xEDa del Medio
      Ambiente a hacer un trabajo a Monteviejo.\r"
    eventType: 0
    optionalParameter: 
    options: []
  - speakerName: Eugenia
    dialogueLine: "Uuuuuuh, cerebro privilegiado. Ma\xF1ana pasate por casa que te
      voy a preparar una tortillica que te vas a chupar los dedos, ya lo ver\xE1s.\r\n\r"
    eventType: 0
    optionalParameter: 
    options:
    - optionText: No soy muy fan de la tortilla
      nextDialogue: {fileID: 11400000, guid: 89d3c4f906af8ce4293ae5dfc68b9691, type: 2}
    - optionText: "\xBFLleva cebolla?"
      nextDialogue: {fileID: 11400000, guid: 5ae54991a47a7e74f87d251d4284408b, type: 2}
    - optionText: No hace falta Eugenia
