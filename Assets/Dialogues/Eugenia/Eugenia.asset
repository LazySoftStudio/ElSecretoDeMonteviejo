  converationLines:
  - speakerName: Eugenia
    dialogueLine: "Buenos d\xEDas, majo, por lo que veo eres nuevo, Me llamo Eugenia
      y soy tu vecina de al lado."
    eventType: 0
    optionalParameter: 
    options:
    - optionText: "\xBFC\xF3mo ha dicho que se llamaba?"
      nextDialogue: {fileID: 11400000, guid: 4271f4a8e3a113e4ca2e6b02bf170c00, type: 2}
    - optionText: "\xBFMe ayudar\xEDa con una cosa?"
